{
  "name": "refluent",
  "version": "2.0.0",
  "description": "Desktop 3D Viewport Reference Tool",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac --x64"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.5",
    "@google/genai": "^1.50.1",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "world.paulus.refluent",
    "productName": "Refluent",
    "copyright": "Copyright © 2026 PAULUS",
    "icon": "assets/icon_with_bg.png",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.production",
        "to": ".env"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "PAULUS"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Refluent",
      "language": "1033",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ko_KR"
      ],
      "include": "build-resources/installer.nsh"
    },
    "mac": {
      "icon": "assets/icon_with_bg.png",
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "icon": "assets/icon_with_bg.png"
    },
    "fileAssociations": [
      {
        "ext": "ent",
        "name": "Refluent Scene",
        "description": "Refluent 3D Scene File",
        "icon": "assets/icon_with_bg.png",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    }
  }
}
